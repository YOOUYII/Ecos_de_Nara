          "effects": [
            { "type": "vocabulary", "word": "Guten Morgen", "meaning": "buenos días", "context": "La panadera te saluda amablemente.", "choices": ["buenas noches", "buenos días", "gracias"], "answer": "buenos días", "confirmed": false },
            { "type": "vocabulary", "word": "Brot", "meaning": "pan", "context": "La panadera ofrece pan caliente mientras pronuncia la palabra.", "choices": ["agua", "pan", "bosque"], "answer": "pan", "confirmed": false },
