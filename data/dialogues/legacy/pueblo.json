        {
          "condition": { "relationship": "friendly" },
          "context": "La panadera señala el pan recién horneado y una jarra de agua fresca en su puesto.",
          "portrait": "res://assets/art/portraits/anim/panadera_amable_talk_3f.png",
          "effects": [
            { "type": "vocabulary", "word": "Guten Morgen", "meaning": "buenos días", "context": "La panadera te saluda amablemente.", "choices": ["buenas noches", "buenos días", "gracias"], "answer": "buenos días", "confirmed": false },
            { "type": "vocabulary", "word": "Brot", "meaning": "pan", "context": "La panadera ofrece pan caliente mientras pronuncia la palabra.", "choices": ["agua", "pan", "bosque"], "answer": "pan", "confirmed": false },
            { "type": "vocabulary", "word": "Wasser", "meaning": "agua", "context": "La panadera te ofrece agua fresca de su jarra.", "choices": ["llave", "camino", "agua"], "answer": "agua", "confirmed": false }
          ],
          "lines": [
            "Guten Morgen! Ich bin die Bäckerin.",
            "Das Brot ist warm und hier ist frisches Wasser."
