            { "type": "vocabulary", "word": "Dorf", "meaning": "pueblo", "context": "El guardia menciona a la aldea mientras agradece tu ayuda.", "choices": ["río", "puente", "pueblo"], "answer": "pueblo", "confirmed": false },
