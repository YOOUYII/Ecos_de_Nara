          "effects": [
            { "type": "vocabulary", "word": "Danke", "meaning": "gracias", "context": "La panadera te da las gracias con una cálida sonrisa.", "choices": ["por favor", "adiós", "gracias"], "answer": "gracias", "confirmed": false }
          ],
          "lines": [
            "Danke für deine Hilfe!",
