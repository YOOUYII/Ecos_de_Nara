          "effects": [
            { "type": "vocabulary", "word": "helfen", "meaning": "ayudar", "context": "La panadera te pide ayuda con un favor.", "choices": ["comer", "ayudar", "correr"], "answer": "ayudar", "confirmed": false },
            { "type": "vocabulary", "word": "Korb", "meaning": "cesta", "context": "La panadera te entrega una cesta de mimbre con pan.", "choices": ["llave", "carta", "cesta"], "answer": "cesta", "confirmed": false },
            { "type": "vocabulary", "word": "Norden", "meaning": "norte", "context": "La panadera señala hacia el camino del norte donde está la salida.", "choices": ["sur", "norte", "este"], "answer": "norte", "confirmed": false },
            { "type": "start_quest", "quest_id": "favor_panadera", "title": "Pan para el leñador", "desc": "Lleva la cesta de pan al guardia en el camino al bosque." },
            { "type": "give_item", "item_id": "cesta_pan" },
            { "type": "set_objective", "objective": "Lleva la cesta de pan de la panadera al guardia Karl en el camino norte hacia el bosque." }
          ],
          "lines": [
            "Kannst du mir helfen? Der Holzfäller im Wald braucht Brot.",
            "Hier ist der Korb mit Brot. Geh nach Norden zum Tor."
